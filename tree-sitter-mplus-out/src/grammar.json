{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mplus_out",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "input_section"
              },
              {
                "type": "SYMBOL",
                "name": "section"
              },
              {
                "type": "SYMBOL",
                "name": "banner_section"
              }
            ]
          }
        }
      ]
    },
    "input_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "heading",
          "content": {
            "type": "SYMBOL",
            "name": "input_heading"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "input_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        }
      ]
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "heading",
          "content": {
            "type": "SYMBOL",
            "name": "heading"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        }
      ]
    },
    "banner_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "banner"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        }
      ]
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "subheading"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_header"
        },
        {
          "type": "SYMBOL",
          "name": "warning"
        },
        {
          "type": "SYMBOL",
          "name": "error"
        },
        {
          "type": "SYMBOL",
          "name": "notice"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "_word"
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[-+]?(\\d+\\.?\\d*|\\.\\d+)([DdEe][-+]?\\d+)?[%*]?"
      }
    },
    "_word": {
      "type": "PATTERN",
      "value": "[^\\s]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "heading"
    },
    {
      "type": "SYMBOL",
      "name": "input_heading"
    },
    {
      "type": "SYMBOL",
      "name": "banner"
    },
    {
      "type": "SYMBOL",
      "name": "subheading"
    },
    {
      "type": "SYMBOL",
      "name": "parameter_header"
    },
    {
      "type": "SYMBOL",
      "name": "warning"
    },
    {
      "type": "SYMBOL",
      "name": "error"
    },
    {
      "type": "SYMBOL",
      "name": "notice"
    },
    {
      "type": "SYMBOL",
      "name": "input_text"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}