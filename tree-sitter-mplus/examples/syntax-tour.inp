TITLE: Model 1: two-group mixture CFA with constraints
    A multi-line title. Data and model words here stay title text,
    analysis of everything; even with punctuation (and parentheses).
    ! a comment inside the title

!* A block comment
   spanning lines *!

DATA:
    FILE IS ../data/my-data.dat;     ! unquoted path
    FILE (male) = "C:\data files\male.dat";
    FORMAT = FREE;
    LISTWISE = ON;

DATA IMPUTATION:
    IMPUTE = y1-y4 (c);
    NDATASETS = 20;
    SAVE = imp*.dat;

VARIABLE:
    NAMES ARE id g y1-y6 x1-x3 u1-u4 w clus;
    USEVARIABLES = y1-y6 x1-x3;
    USEOBSERVATIONS = x1 GT 0 AND g NE 9;
    CATEGORICAL = u1-u4;
    MISSING ARE ALL (-999);
    GROUPING IS g (1 = male 2 = female);
    CLASSES = c (2);
    CLUSTER = clus;
    WITHIN = x1;
    BETWEEN = (clus) w;
    AUXILIARY = (R3STEP) x2;
    IDVARIABLE = id;

DEFINE:
    CENTER x1 (GRANDMEAN);
    xsq = x1**2;
    lx = LOG(x2 + 1);
    IF (x3 == 1) THEN grp = 1;
    IF (x3 /= 1) THEN grp = 0;
    m = MEAN(y1-y3);
    DO(1,3) z# = y# / 2;

ANALYSIS:
    TYPE = MIXTURE COMPLEX;
    ESTIMATOR = MLR;
    ALGORITHM = INTEGRATION;
    STARTS = 100 20;
    K-1STARTS = 50 10;
    PROCESSORS = 4 (STARTS);
    CONVERGENCE = 1E-5;
    BITERATIONS = 100000 (5000);
    MODEL = NOMEANSTRUCTURE;

MODEL:
    %OVERALL%
    f1 BY y1-y3* (l1-l3);
    f2 BY y4@1 y5 y6;
    f1@1;
    f1 WITH f2 (cov);
    f2 ON f1 (b1)
          x1 x2 (b2-b3);
    [y1-y6] (int1-int6);
    [u1$1@0 u2$1];
    {u1-u4@1};
    s | f2 ON x3;
    int | f1 XWITH f2;
    i s | y1@0 y2@1 y3@2;
    c ON x1;
    [c#1@0];

    %c#2%
    f1 BY y1-y3*0.8;

MODEL female:
    f1 BY y2;

MODEL INDIRECT:
    f2 IND f1 x1;
    f2 VIA f1 x1;

MODEL CONSTRAINT:
    NEW(ab diff);
    ab = b1*b2;
    diff = l1 - l2;
    0 = l2 - l3;
    PLOT(ind);
    LOOP(mod, -2, 2, 0.1);
    ind = (b1 + b3*mod)*b2;

MODEL TEST:
    0 = b1 - b2;

MODEL PRIORS:
    b1 ~ N(0, 0.01);
    DIFF(l1-l3) ~ N(0, 0.001);

OUTPUT:
    SAMPSTAT STANDARDIZED(STDYX) TECH1 TECH4;
    MODINDICES(ALL 3.84);
    CINTERVAL(BCBOOTSTRAP);

SAVEDATA:
    FILE IS fscores.dat;
    SAVE = FSCORES CPROBABILITIES;
    RESULTS ARE results.dat;

PLOT:
    TYPE = PLOT3;
    SERIES = y1-y3 (*);
