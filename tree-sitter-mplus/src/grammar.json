{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mplus",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_section"
      }
    },
    "_section": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "title_section"
        },
        {
          "type": "SYMBOL",
          "name": "option_section"
        },
        {
          "type": "SYMBOL",
          "name": "model_section"
        },
        {
          "type": "SYMBOL",
          "name": "expression_section"
        }
      ]
    },
    "title_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "header",
          "content": {
            "type": "SYMBOL",
            "name": "title_header"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "title_text"
          }
        }
      ]
    },
    "option_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "header",
          "content": {
            "type": "SYMBOL",
            "name": "option_header"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "option_statement"
          }
        }
      ]
    },
    "model_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "header",
          "content": {
            "type": "SYMBOL",
            "name": "model_header"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "statement"
              },
              {
                "type": "SYMBOL",
                "name": "class_label"
              }
            ]
          }
        }
      ]
    },
    "expression_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "header",
          "content": {
            "type": "SYMBOL",
            "name": "expression_header"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "statement"
          }
        }
      ]
    },
    "title_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[tT][iI][tT][lL]([eE])?[ \\t]*:"
      }
    },
    "option_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "([dD][aA][tT][aA]([ \\t]+[A-Za-z]+)?|[vV][aA][rR][iI]([aA]([bB]([lL]([eE]([sS])?)?)?)?)?|[aA][nN][aA][lL]([yY]([sS]([iI]([sS])?)?)?)?|[mM][oO][nN][tT]([eE]([cC]([aA]([rR]([lL]([oO])?)?)?)?)?)?|[oO][uU][tT][pP]([uU]([tT])?)?|[sS][aA][vV][eE]([dD]([aA]([tT]([aA])?)?)?)?|[pP][lL][oO][tT])[ \\t]*:"
      }
    },
    "model_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[mM][oO][dD][eE]([lL])?([ \\t]+[A-Za-z0-9_.\\-]+)?[ \\t]*:"
      }
    },
    "expression_header": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "([dD][eE][fF][iI]([nN]([eE])?)?|[mM][oO][dD][eE]([lL])?[ \\t]+([cC][oO][nN][sS]([tT]([rR]([aA]([iI]([nN]([tT])?)?)?)?)?)?|[tT][eE][sS][tT]|[pP][rR][iI][oO]([rR]([sS])?)?))[ \\t]*:"
        }
      }
    },
    "option_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_option_value"
          }
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "is_are": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[iI][sS]|[aA][rR][eE]"
        }
      }
    },
    "_option_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "SYMBOL",
          "name": "option_group"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "SYMBOL",
          "name": "is_are"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": "."
        }
      ]
    },
    "option_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_option_value"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "group"
        },
        {
          "type": "SYMBOL",
          "name": "bracket_group"
        },
        {
          "type": "SYMBOL",
          "name": "brace_group"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": ","
        }
      ]
    },
    "group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "bracket_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "brace_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_item"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "class_label": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "%[^%\\n;]*%"
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+(\\.\\d*)?([eE][+-]?\\d+)?|\\.\\d+([eE][+-]?\\d+)?"
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"[^\"\\n]*\""
          },
          {
            "type": "PATTERN",
            "value": "'[^'\\n]*'"
          }
        ]
      }
    },
    "path": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "([A-Za-z]:)?[A-Za-z_.\\/\\\\~][A-Za-z0-9_\\-*]*([.\\/\\\\][A-Za-z0-9_.\\/\\\\~\\-*]*)+"
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "**"
          },
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "STRING",
            "value": "+"
          },
          {
