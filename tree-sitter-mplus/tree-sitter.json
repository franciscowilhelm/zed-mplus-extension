{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mplus",
      "camelcase": "Mplus",
      "title": "Mplus",
      "scope": "source.mplus",
      "path": ".",
      "file-types": ["inp"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(mplus|inp)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Mplus input (.inp) files",
    "links": {
      "repository": "https://github.com/franciscowilhelm/zed-mplus-extension"
    }
  }
}
